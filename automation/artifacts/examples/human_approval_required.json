{
  "schema_version": "0.1",
  "name": "human_approval_required",
  "description": "Log in, attempt a high-value sub-account opening, and pause for human approval.",
  "inputs": {
    "operator_id": "operator",
    "password": "password",
    "member_id": "12345",
    "product_name": "Savings Plus",
    "initial_deposit": "5000.01"
  },
  "steps": [
    {
      "id": "open_login",
      "action": "goto",
      "url": "/login"
    },
    {
      "id": "enter_operator_id",
      "action": "fill",
      "selector": "#operatorId",
      "value": "{{operator_id}}"
    },
    {
      "id": "enter_password",
      "action": "fill",
      "selector": "#password",
      "value": "{{password}}"
    },
    {
      "id": "submit_login",
      "action": "click",
      "selector": "button:has-text('Sign in')"
    },
    {
      "id": "enter_member_id",
      "action": "fill",
      "selector": "#memberId",
      "value": "{{member_id}}"
    },
    {
      "id": "search_member",
      "action": "click",
      "selector": "button:has-text('Search member records')"
    },
    {
      "id": "open_subaccount_form",
      "action": "click",
      "selector": "a:has-text('Open sub-account')"
    },
    {
      "id": "enter_product_name",
      "action": "fill",
      "selector": "#productName",
      "value": "{{product_name}}"
    },
    {
      "id": "enter_initial_deposit",
      "action": "fill",
      "selector": "#initialDeposit",
      "value": "{{initial_deposit}}"
    },
    {
      "id": "submit_subaccount",
      "action": "click",
      "selector": "button:has-text('Open sub-account')"
    }
  ],
  "expected_outcomes": [
    {
      "name": "human_approval_required",
      "status": "handoff_required",
      "selector": ".banner.warning",
      "contains_text": "Human approval required",
      "message": "Initial deposits over $5,000 require a human operator decision."
    }
  ],
  "handoff": {
    "enabled": true,
    "reason": "Initial deposit is above the unattended automation threshold.",
    "resume_selector": "#confirmation-code",
    "operator_instructions": "Review the high-value opening request. In this training mock, lower the Initial deposit to 100.00, submit the form again, then return to the terminal and press Enter."
  },
  "outputs": {
    "member_id": "//tr[th[normalize-space()='Member ID']]/td",
    "member_name": "//tr[th[normalize-space()='Member name']]/td",
    "new_account_number": "//tr[th[normalize-space()='New account number']]/td",
    "product": "//tr[th[normalize-space()='Product']]/td",
    "opening_balance": "//tr[th[normalize-space()='Opening balance']]/td"
  },
  "checkpoint": {
    "selector": "#confirmation-code",
    "text": "CONFIRM-SUBACCOUNT-CREATED"
  },
  "version": "0.1.0",
  "approval_state": "draft",
  "metadata": {
    "owner": "mock-bank-automation",
    "app": "mock-bank",
    "app_version": "local-dev",
    "notes": "Production-contract mock bank artifact."
  },
  "input_schema": {
    "operator_id": {
      "type": "string",
      "description": "Demo back-office operator username.",
      "required": true,
      "sensitive": false
    },
    "password": {
      "type": "string",
      "description": "Demo back-office operator password.",
      "required": true,
      "sensitive": true
    },
    "member_id": {
      "type": "string",
      "description": "Mock bank member identifier used by the workflow.",
      "required": true,
      "sensitive": false
    },
    "product_name": {
      "type": "string",
      "description": "Sub-account product name entered in the form.",
      "required": true,
      "sensitive": false
    },
    "initial_deposit": {
      "type": "string",
      "description": "Initial deposit amount entered for the new sub-account.",
      "required": true,
      "sensitive": false
    }
  },
  "output_schema": {
    "member_id": {
      "type": "string",
      "description": "Member identifier shown on the confirmation page.",
      "required": true,
      "sensitive": false
    },
    "member_name": {
      "type": "string",
      "description": "Member name shown on the confirmation page.",
      "required": true,
      "sensitive": false
    },
    "new_account_number": {
      "type": "string",
      "description": "New sub-account number produced by the mock bank.",
      "required": true,
      "sensitive": false
    },
    "product": {
      "type": "string",
      "description": "Product name confirmed by the mock bank.",
      "required": true,
      "sensitive": false
    },
    "opening_balance": {
      "type": "string",
      "description": "Opening balance confirmed by the mock bank.",
      "required": true,
      "sensitive": false
    }
  },
  "safety": {
    "allowed_actions": [
      "goto",
      "fill",
      "click",
      "wait_for_selector"
    ],
    "allowed_hosts": [
      "localhost",
      "localhost:8080",
      "127.0.0.1",
      "127.0.0.1:8080"
    ],
    "allowed_exact_paths": [
      "/"
    ],
    "allowed_path_prefixes": [
      "/login",
      "/members",
      "/logout",
      "/debug",
      "/ops",
      "/h2-console"
    ],
    "risky_action_policy": "allow",
    "risky_selectors": [
      "button:has-text('Open sub-account')"
    ],
    "redact_input_keys": [
      "password",
      "token",
      "secret"
    ]
  }
}
