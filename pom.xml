<?xml version="1.0" encoding="UTF-8"?>
<!--
    Aggregator for the Java services. `./mvnw verify` here builds and tests both;
    `-pl services/bank-api` (or audit-consumer) targets one. Each service keeps
    spring-boot-starter-parent as its own parent, so it still builds on its own
    (e.g. inside its Docker image).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.hp2324</groupId>
    <artifactId>mock-bank-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mock-bank-parent</name>

    <modules>
        <module>services/bank-api</module>
        <module>services/audit-consumer</module>
    </modules>
</project>
